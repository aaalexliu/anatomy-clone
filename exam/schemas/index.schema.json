{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.schema.json",
  "title": "Exam card index",
  "type": "object",
  "required": ["banner", "prototypes", "items", "cells"],
  "properties": {
    "banner": {"const": "model estimate, not EMG"},
    "prototypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"}
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "note": {"type": "string"},
          "negative_control": {"type": "boolean"}
        }
      }
    },
    "cells": {"type": "array"}
  }
}
